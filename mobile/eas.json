{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "appleTeamId": "3KA9RC7YE6"
      }
    },
    "ios-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true,
        "appleTeamId": "3KA9RC7YE6"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "ios": {
        "appleTeamId": "3KA9RC7YE6"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "3KA9RC7YE6"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}

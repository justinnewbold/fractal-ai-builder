{
  "expo": {
    "name": "Fractal Remote",
    "slug": "fractal-remote",
    "owner": "justinnewbold",
    "version": "1.8.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fractalremote",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d0f12",
    "primaryColor": "#f0a73c",
    "platforms": [
      "ios",
      "android"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f590cdd2-a0b7-4a94-9027-0a00ab60bdc6",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "cloud.newbold.fractalremote",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cloud.newbold.fractalremote",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d0f12"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0d0f12",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fractal Remote uses the camera only to read the pairing code your computer shows on screen.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f590cdd2-a0b7-4a94-9027-0a00ab60bdc6"
      },
      "revenuecat": {
        "ios": "appl_gpPuXMTsyVDKzczhneWWyjDiIrq",
        "android": "goog_lbrKOXudziJAvmulAquOMQVQBXk"
      }
    }
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron needs these under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!--
      ForgeFX answers a phone on the LAN, and reaches the account service.

      No com.apple.security.device.usb: that is an App Sandbox entitlement, and
      this app is not sandboxed — there is no com.apple.security.app-sandbox
      key here, so it was inert. Serial access under the hardened runtime needs
      no entitlement; claiming one that does nothing only reads as an oversight.
    -->
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
  </dict>
</plist>
